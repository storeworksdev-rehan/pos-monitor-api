{
  // Store-specific values (StoreId, DeviceId, ApiKey, connection string) normally go in
  // %ProgramData%\PosMonitoringAgent\agentsettings.json, written by Installer\install.ps1.
  "Agent": {
    "StoreId": "00001",
    "DeviceId": null,
    "DataDirectory": "%ProgramData%\\PosMonitoringAgent",
    "Intervals": {
      "SystemMetricsSeconds": 60,
      "ApplicationHealthSeconds": 30,
      "ConnectivitySeconds": 60,
      "HeartbeatSeconds": 60,
      "LogCollectionSeconds": 120,
      "UploadSeconds": 30
    }
  },
  "TelemetryApi": {
    "BaseUrl": "https://pos-monitor-api-dzeacbc9fra5asa8.southcentralus-01.azurewebsites.net",
    "ApiKey": "",
    "BatchPath": "api/telemetry/batch",
    "HealthPath": "api/health",
    "TimeoutSeconds": 30,
    "MaxBatchEvents": 200,
    "MaxBatchBytes": 524288,
    "EnableGzip": false,
    "BackoffBaseSeconds": 5,
    "BackoffMaxSeconds": 300,
    "CriticalFlushMinIntervalSeconds": 15
  },
  "LocalQueue": {
    "MaxDatabaseSizeMB": 200,
    "RoutineRetentionHours": 72,
    "CriticalRetentionDays": 14,
    "DownsampleMetricsAfterHours": 6,
    "DownsampleBucketMinutes": 15,
    "MaxDeliveryAttempts": 5,
    "MaintenanceIntervalMinutes": 10
  },
  "PosApplication": {
    "Name": "StellaNova MRF",
    "ProcessNames": [ "StellaNovaMRF" ],
    "ExecutablePath": "",
    "LogDirectory": "",
    "LogFilePattern": "*.log",
    "LogErrorPatterns": [ "\\bFATAL\\b", "\\bCRITICAL\\b", "\\bERROR\\b", "Exception" ],
    "MaxLogEntriesPerCycle": 100,
    "MaxBytesPerFilePerCycle": 1048576,
    "MaxMessageLength": 2000
  },
  "SqlHealth": {
    "Enabled": true,
    "ConnectionString": "Server=localhost;Database=StellaNovaMRF;Integrated Security=True;TrustServerCertificate=True",
    "ConnectTimeoutSeconds": 5,
    // Optional. Aggregates only, e.g.:
    // "SELECT COUNT(*) AS TransactionsLastHour, MAX(CreatedAt) AS LastTransactionAt, SUM(CASE WHEN Status = 'Failed' THEN 1 ELSE 0 END) AS FailedLastHour FROM dbo.Transactions WHERE CreatedAt >= DATEADD(HOUR, -1, GETDATE())"
    "TransactionHealthQuery": "",
    "QueryTimeoutSeconds": 10
  },
  "EventLog": {
    "Channels": [ "Application", "System" ],
    "MaxLevel": 2,
    "ProviderAllowList": [],
    "ProviderDenyList": [ "Microsoft-Windows-DistributedCOM" ],
    // 1000 = Application Error (crash), 1002 = Application Hang, 1026 = .NET Runtime unhandled exception
    "CriticalEventIds": [ 1000, 1002, 1026 ],
    "InitialLookbackMinutes": 60,
    "MaxEventsPerCycle": 100,
    "MaxMessageLength": 2000
  },
  "FileAccess": {
    // Read-only remote browsing of POS log files from the dashboard. Nothing outside RootPath is ever served.
    "Enabled": true,
    "RootPath": "C:\\XeniaRetail\\Logs",
    "AllowedExtensions": [ ".log", ".txt", ".csv", ".json", ".xml" ],
    "MaxReadBytes": 1048576,
    "MaxListEntries": 2000,
    "MaxRecursionDepth": 6,
    "RedactContent": true,
    "PollWaitSeconds": 20
  },
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.Hosting.Lifetime": "Information",
      "System.Net.Http.HttpClient": "Warning"
    },
    "EventLog": {
      "LogLevel": {
        "Default": "Warning"
      }
    }
  }
}
