{
  // Local debugging: queue in .\data next to the exe, fast intervals, notepad as a stand-in POS.
  "Agent": {
    "StoreId": "DEVSTORE",
    "DataDirectory": "data",
    "Intervals": {
      "SystemMetricsSeconds": 15,
      "ApplicationHealthSeconds": 10,
      "ConnectivitySeconds": 15,
      "HeartbeatSeconds": 15,
      "LogCollectionSeconds": 20,
      "UploadSeconds": 10
    }
  },
  "PosApplication": {
    "ProcessNames": [ "StellaNovaMRF" ]
  },
  "SqlHealth": {
    "ConnectionString": "Server=localhost;Database=StellaNovaMRF;Integrated Security=True;TrustServerCertificate=True"
  },
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "PosMonitoringAgent": "Debug",
      "System.Net.Http.HttpClient": "Warning"
    }
  }
}
