# Copy to .env (loaded automatically by `npm start` / `npm run dev`). Every setting is optional.

PORT=4000
HOST=0.0.0.0
# Origins allowed to read the dashboard endpoints (the Next.js frontend). Comma-separated, or * for any.
CORS_ORIGINS=http://localhost:3100

# Comma-separated API keys the agents may use (TelemetryApi:ApiKey). Empty = accept any agent (development only).
TELEMETRY_API_KEYS=

# ---- Retention ----------------------------------------------------------------
# Routine data (metric history, routine events) is kept only for this rolling window, then deleted
# (in memory and in MongoDB).
DATA_WINDOW_MINUTES=10
# Failures, errors and warnings are frozen into incident snapshots (device state + the live window
# leading up to it) and kept this long.
INCIDENT_RETENTION_DAYS=30
# Triggers on the same device within this many seconds join one incident.
INCIDENT_MERGE_SECONDS=120
# The same error again on the same device within this many hours joins the incident that already has it
# (its count goes up) instead of opening a new one. Alerts and MongoDB keep one record per repeated error.
DUPLICATE_WINDOW_HOURS=24
# Incident snapshots held in memory (MongoDB keeps every one for the retention period).
INCIDENTS_MAX=500

# ---- Optional MongoDB ------------------------------------------------------------
# Leave empty to run with no database (memory + snapshot file).
MONGODB_URI=
MONGODB_DB=pos_monitoring
# While MongoDB is unreachable, accepted events are spooled to disk up to this size, then agents are told to retry.
SPOOL_MAX_MB=500

# ---- Local files -------------------------------------------------------------------
DATA_DIR=.data
SNAPSHOT_SECONDS=60

# ---- POS log file browsing --------------------------------------------------------
# Only paths under this folder are relayed to agents (each agent also enforces FileAccess:RootPath itself).
FILE_ROOT=C:\XeniaRetail\Logs
# How long the dashboard waits for a POS to answer a file request.
FILE_REQUEST_TIMEOUT_SECONDS=30

# ---- Device status and limits -------------------------------------------------------
# A device is "delayed" after STALE_SECONDS without data and "offline" (incident raised) after OFFLINE_SECONDS.
STALE_SECONDS=180
OFFLINE_SECONDS=600
HISTORY_POINTS=600
EVENTS_PER_DEVICE=100
ALERTS_MAX=300
MAX_BODY_MB=10
